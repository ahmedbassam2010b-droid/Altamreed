rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get("active", true)==true;}
  function owns(uid){return signedIn() && request.auth.uid==uid;}
  function userDocExists(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));}
  function studentGrade(){return userDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("gradeId","") : "";}
  function validGrade(gradeId){return gradeId is string && exists(/databases/$(database)/documents/grades/$(gradeId)) && get(/databases/$(database)/documents/grades/$(gradeId)).data.get("active",false)==true;}
  function gradeAccess(){return signedIn() && userDocExists() && resource.data.get("gradeId","")!="" && resource.data.gradeId==studentGrade();}
  match /admins/{uid}{allow get:if owns(uid);allow list,create,update,delete:if false;}
  match /grades/{id}{
   allow read:if isAdmin()||resource.data.get("active",false)==true;
   allow create,update,delete:if isAdmin();
  }
  match /users/{uid}{
   allow read:if owns(uid)||isAdmin();
   allow create:if owns(uid)&&request.resource.data.uid==uid&&request.resource.data.gradeId is string&&validGrade(request.resource.data.gradeId);
   allow update:if isAdmin()||(owns(uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','updatedAt']))||(owns(uid)&&!resource.data.keys().hasAny(['gradeId'])&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gradeId','gradeName','updatedAt'])&&validGrade(request.resource.data.gradeId));
   allow delete:if isAdmin();
   match /bookmarks/{bookmarkId}{allow read,write:if owns(uid);}
   match /lessonProgress/{lessonId}{allow read,write:if owns(uid);}
  }
  match /publicProfiles/{uid}{
   allow read:if signedIn();
   allow create:if isAdmin()||(owns(uid)&&request.resource.data.keys().hasOnly(['displayName','xp','updatedAt'])&&request.resource.data.xp==0);
   allow update:if isAdmin()||(owns(uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt']))||(owns(uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp','updatedAt'])&&request.resource.data.xp is number&&request.resource.data.xp>=resource.data.get('xp',0)&&request.resource.data.xp<=resource.data.get('xp',0)+40);
   allow delete:if isAdmin();
  }
  function validTaskForStudent(taskId){return signedIn()&&userDocExists()&&exists(/databases/$(database)/documents/gamificationTasks/$(taskId))&&get(/databases/$(database)/documents/gamificationTasks/$(taskId)).data.get("published",false)==true&&get(/databases/$(database)/documents/gamificationTasks/$(taskId)).data.get("gradeId","")==studentGrade();}
  match /gamificationTasks/{id}{
   allow read:if isAdmin()||(resource.data.get("published",false)==true&&gradeAccess());
   allow create,update,delete:if isAdmin();
  }
  match /gamificationSubmissions/{id}{
   allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);
   allow create:if signedIn()&&request.resource.data.uid==request.auth.uid&&request.resource.data.taskId is string&&request.resource.data.status=="pending"&&id==request.resource.data.taskId+"_"+request.auth.uid&&validTaskForStudent(request.resource.data.taskId);
   allow update,delete:if isAdmin();
  }
  match /xpTransactions/{id}{
   allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);
   allow create:if (isAdmin()&&request.resource.data.uid is string&&request.resource.data.amount is int&&request.resource.data.amount>0&&request.resource.data.reason is string)||(owns(request.resource.data.uid)&&request.resource.data.amount is int&&request.resource.data.amount>0&&request.resource.data.amount<=40&&request.resource.data.sourceType in ['exam','challenge']&&request.resource.data.reason is string);
   allow update,delete:if false;
  }
  match /subjects/{id}{allow read:if isAdmin()||(resource.data.published==true&&gradeAccess());allow create,update,delete:if isAdmin();}
  match /chapters/{id}{allow read:if isAdmin()||(resource.data.published==true&&gradeAccess());allow create,update,delete:if isAdmin();}
  match /lessons/{id}{allow read:if isAdmin()||(resource.data.published==true&&gradeAccess());allow create,update,delete:if isAdmin();}
  match /exams/{id}{allow read:if isAdmin()||(resource.data.published==true&&gradeAccess());allow create,update,delete:if isAdmin();}
  match /examAnswerKeys/{id}{allow read:if isAdmin()||(signedIn()&&exists(/databases/$(database)/documents/exams/$(id))&&get(/databases/$(database)/documents/exams/$(id)).data.get("published",false)==true&&get(/databases/$(database)/documents/exams/$(id)).data.get("gradeId","")==studentGrade());allow write:if isAdmin();}
  match /library/{id}{allow read:if isAdmin()||(resource.data.published==true&&gradeAccess());allow create,update,delete:if isAdmin();}
  match /notifications/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.published==true);allow create,update,delete:if isAdmin();}
  match /revisionCards/{id}{allow read:if isAdmin()||(resource.data.published==true&&gradeAccess());allow create,update,delete:if isAdmin();}
  match /dailyChallenges/{id}{allow read:if isAdmin()||(resource.data.published==true&&gradeAccess());allow create,update,delete:if isAdmin();}
  match /challengeAnswerKeys/{id}{allow read:if isAdmin()||(signedIn()&&exists(/databases/$(database)/documents/dailyChallenges/$(id))&&get(/databases/$(database)/documents/dailyChallenges/$(id)).data.get("published",false)==true&&get(/databases/$(database)/documents/dailyChallenges/$(id)).data.get("gradeId","")==studentGrade());allow write:if isAdmin();}
  match /simulations/{id}{allow read:if isAdmin()||(resource.data.published==true&&gradeAccess());allow create,update,delete:if isAdmin();}
  match /simulationSubmissions/{id}{
   allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);
   allow create:if signedIn()&&userDocExists()&&studentGrade()!=""&&validGrade(studentGrade())
     &&request.resource.data.keys().hasOnly(['uid','simulationId','lessonId','completedSteps','totalSteps','score','elapsedSeconds','mistakes','status','xpAwarded','createdAt'])
     &&request.resource.data.uid==request.auth.uid
     &&request.resource.data.simulationId=='hand-hygiene-lesson-03'
     &&request.resource.data.lessonId=='fundamentals-lesson-03'
     &&request.resource.data.completedSteps==10
     &&request.resource.data.totalSteps==10
     &&request.resource.data.score==100
     &&request.resource.data.status=='pending'
     &&request.resource.data.xpAwarded==0
     &&id=='hand-hygiene-lesson-03_'+request.auth.uid;
   allow update,delete:if isAdmin();
  }
  match /studyTasks/{id}{
   allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);
   allow create:if signedIn()&&request.resource.data.uid==request.auth.uid;
   allow update:if signedIn()&&resource.data.uid==request.auth.uid&&request.resource.data.uid==request.auth.uid;
   allow delete:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);
  }
  match /examResults/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);allow create,update,delete:if isAdmin();}
  match /examAttempts/{id}{allow create:if signedIn()&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=="graded"&&request.resource.data.examId is string&&exists(/databases/$(database)/documents/exams/$(request.resource.data.examId))&&get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.get("published",false)==true&&get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.get("gradeId","")==studentGrade()&&request.resource.data.answers is list&&request.resource.data.questionCount==request.resource.data.answers.size()&&request.resource.data.score is number&&request.resource.data.maxScore is number&&request.resource.data.percentage is number&&request.resource.data.xpAwarded is number&&request.resource.data.keys().hasOnly(["uid","examId","examTitle","answers","questionCount","status","score","maxScore","percentage","xpAwarded","duration","submittedAt","autoSubmitted"]);allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);allow update,delete:if isAdmin();}
  match /challengeResponses/{id}{allow create:if signedIn()&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=="graded"&&request.resource.data.challengeId is string&&exists(/databases/$(database)/documents/dailyChallenges/$(request.resource.data.challengeId))&&get(/databases/$(database)/documents/dailyChallenges/$(request.resource.data.challengeId)).data.get("published",false)==true&&get(/databases/$(database)/documents/dailyChallenges/$(request.resource.data.challengeId)).data.get("gradeId","")==studentGrade()&&id==request.resource.data.challengeId+"_"+request.auth.uid&&request.resource.data.selectedIndex is int&&request.resource.data.isCorrect is bool&&request.resource.data.xpAwarded is int&&request.resource.data.keys().hasOnly(["uid","challengeId","selectedIndex","isCorrect","status","xpAwarded","submittedAt"]);allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);allow update,delete:if isAdmin();}
  match /communityPosts/{id}{allow read:if signedIn();allow create:if signedIn()&&request.resource.data.uid==request.auth.uid;allow update,delete:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);}
  match /messages/{id}{allow create:if signedIn()&&request.resource.data.uid==request.auth.uid;allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);allow update,delete:if isAdmin();}
  // Bawabet Teachers: manual academy management, subscriptions and student memberships.
  function teacherExists(uid){return exists(/databases/$(database)/documents/teachers/$(uid));}
  function teacherData(uid){return get(/databases/$(database)/documents/teachers/$(uid)).data;}
  function teacherAccountActive(uid){return teacherExists(uid) && teacherData(uid).get("active",false)==true && teacherData(uid).get("status","")=="active" && teacherData(uid).subscriptionStartAt<=request.time && teacherData(uid).subscriptionEndAt>request.time;}
  function teacherActive(){return signedIn() && teacherAccountActive(request.auth.uid);}
  function academyOwner(teacherUid){return teacherActive() && request.auth.uid==teacherUid;}
  function academyLinked(teacherUid){return signedIn() && exists(/databases/$(database)/documents/academyMemberships/$(request.auth.uid+"_"+teacherUid)) && get(/databases/$(database)/documents/academyMemberships/$(request.auth.uid+"_"+teacherUid)).data.get("status","")=="active";}
  function academyMember(teacherUid){return academyLinked(teacherUid) && teacherAccountActive(teacherUid);}
  // Public academy branding directory. Only the owning active teacher may edit branding; ownership and slug stay immutable.
  match /academyProfiles/{slug}{
   allow read:if true;
   allow create:if isAdmin()&&request.resource.data.teacherUid is string&&request.resource.data.slug==slug;
   allow update:if signedIn()&&resource.data.teacherUid==request.auth.uid&&teacherAccountActive(request.auth.uid)&&request.resource.data.teacherUid==resource.data.teacherUid&&request.resource.data.slug==resource.data.slug&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","tagline","specialty","logoUrl","themeColor","updatedAt"]);
   allow delete:if isAdmin();
  }
  match /teachers/{uid}{
   allow read:if isAdmin()||owns(uid)||academyLinked(uid);
   allow create,update,delete:if isAdmin();
  }
  match /teacherCodes/{code}{
   allow read,write:if isAdmin();
  }
  match /teacherClasses/{id}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid);
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid;
   allow update,delete:if academyOwner(resource.data.teacherUid);
  }
  match /teacherGroups/{id}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid)||academyMember(resource.data.teacherUid);
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid;
   allow update,delete:if academyOwner(resource.data.teacherUid);
  }
  match /teacherSubjects/{id}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid)||academyMember(resource.data.teacherUid);
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid;
   allow update,delete:if academyOwner(resource.data.teacherUid);
  }
  match /academyInvites/{code}{
   allow read:if isAdmin()||(signedIn()&&resource.data.get("active",false)==true&&teacherAccountActive(resource.data.teacherUid));
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid;
   allow update:if isAdmin()||academyOwner(resource.data.teacherUid)||(signedIn()&&resource.data.get("active",false)==true&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uses"])&&request.resource.data.uses==resource.data.get("uses",0)+1);
   allow delete:if isAdmin()||academyOwner(resource.data.teacherUid);
  }
  match /academyMemberships/{id}{
   allow read:if isAdmin()||(signedIn()&&resource.data.studentUid==request.auth.uid)||academyOwner(resource.data.teacherUid);
   allow create:if signedIn()&&request.resource.data.studentUid==request.auth.uid&&request.resource.data.status=="active"&&request.resource.data.teacherUid is string&&id==request.auth.uid+"_"+request.resource.data.teacherUid&&request.resource.data.inviteCode is string&&exists(/databases/$(database)/documents/academyInvites/$(request.resource.data.inviteCode))&&get(/databases/$(database)/documents/academyInvites/$(request.resource.data.inviteCode)).data.get("active",false)==true&&get(/databases/$(database)/documents/academyInvites/$(request.resource.data.inviteCode)).data.teacherUid==request.resource.data.teacherUid&&get(/databases/$(database)/documents/academyInvites/$(request.resource.data.inviteCode)).data.classId==request.resource.data.classId&&get(/databases/$(database)/documents/academyInvites/$(request.resource.data.inviteCode)).data.get("groupId","")==request.resource.data.get("groupId","")&&get(/databases/$(database)/documents/academyInvites/$(request.resource.data.inviteCode)).data.expiresAt>request.time&&teacherAccountActive(request.resource.data.teacherUid);
   allow update,delete:if isAdmin()||academyOwner(resource.data.teacherUid);
  }
  match /teacherContent/{id}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid)||(academyMember(resource.data.teacherUid)&&resource.data.get("active",false)==true&&resource.data.classId==get(/databases/$(database)/documents/academyMemberships/$(request.auth.uid+"_"+resource.data.teacherUid)).data.classId);
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid;
   allow update,delete:if academyOwner(resource.data.teacherUid);
  }
  match /teacherExams/{id}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid)||(academyMember(resource.data.teacherUid)&&resource.data.get("published",false)==true);
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid;
   allow update,delete:if academyOwner(resource.data.teacherUid);
  }
  // Private answer keys: never readable by academy students.
  match /teacherExamAnswerKeys/{examId}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid);
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid&&request.resource.data.examId==examId&&request.resource.data.answerIndexes is list;
   allow update,delete:if academyOwner(resource.data.teacherUid);
  }
  // Students submit answers once. Teachers can review and grade; students can only read their own result.
  match /teacherExamAttempts/{attemptId}{
   allow get:if isAdmin()||academyOwner(resource.data.teacherUid)||(signedIn()&&(resource.data.studentUid==request.auth.uid||attemptId.matches(".*_"+request.auth.uid)));
   allow list:if isAdmin()||academyOwner(resource.data.teacherUid)||(signedIn()&&resource.data.studentUid==request.auth.uid);
   allow create:if signedIn()
     &&request.resource.data.studentUid==request.auth.uid
     &&request.resource.data.teacherUid is string
     &&request.resource.data.examId is string
     &&request.resource.data.status=="submitted"
     &&request.resource.data.answers is list
     &&attemptId==request.resource.data.examId+"_"+request.auth.uid
     &&exists(/databases/$(database)/documents/teacherExams/$(request.resource.data.examId))
     &&get(/databases/$(database)/documents/teacherExams/$(request.resource.data.examId)).data.get("published",false)==true
     &&get(/databases/$(database)/documents/teacherExams/$(request.resource.data.examId)).data.teacherUid==request.resource.data.teacherUid
     &&get(/databases/$(database)/documents/teacherExams/$(request.resource.data.examId)).data.classId==request.resource.data.classId
     &&request.resource.data.answers.size()==get(/databases/$(database)/documents/teacherExams/$(request.resource.data.examId)).data.questions.size()
     &&academyMember(request.resource.data.teacherUid)
     &&get(/databases/$(database)/documents/academyMemberships/$(request.auth.uid+"_"+request.resource.data.teacherUid)).data.classId==request.resource.data.classId
     &&request.resource.data.keys().hasOnly(["teacherUid","studentUid","examId","examTitle","classId","className","answers","status","submittedAt"]);
   allow update:if academyOwner(resource.data.teacherUid)
     &&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["score","maxScore","feedback","status","gradedAt"])
     &&request.resource.data.status=="graded"
     &&request.resource.data.score is number
     &&request.resource.data.maxScore is number
     &&request.resource.data.score>=0
     &&request.resource.data.score<=request.resource.data.maxScore;
   allow delete:if isAdmin();
  }
  match /teacherPosts/{id}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid)||academyMember(resource.data.teacherUid);
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid;
   allow update,delete:if academyOwner(resource.data.teacherUid);
  }
  match /teacherDailyAttendance/{id}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid)||(signedIn()&&resource.data.studentUid==request.auth.uid);
   allow create:if signedIn()&&request.resource.data.studentUid==request.auth.uid&&request.resource.data.teacherUid is string&&request.resource.data.classId is string&&request.resource.data.dateKey is string&&request.resource.data.status=="present"&&request.resource.data.source=="student-self-checkin"&&id==request.auth.uid+"_"+request.resource.data.teacherUid+"_"+request.resource.data.dateKey&&academyMember(request.resource.data.teacherUid)&&exists(/databases/$(database)/documents/academyMemberships/$(request.auth.uid+"_"+request.resource.data.teacherUid))&&get(/databases/$(database)/documents/academyMemberships/$(request.auth.uid+"_"+request.resource.data.teacherUid)).data.classId==request.resource.data.classId;
   allow update,delete:if false;
  }
  match /teacherConversations/{id}{
   allow read:if isAdmin()||(signedIn()&&resource.data.teacherUid==request.auth.uid&&academyOwner(request.auth.uid))||(signedIn()&&resource.data.participantUids is list&&request.auth.uid in resource.data.participantUids);
   allow create:if signedIn()&&request.resource.data.participantUids is list&&request.auth.uid in request.resource.data.participantUids&&request.resource.data.studentUid==request.auth.uid&&teacherAccountActive(request.resource.data.teacherUid)&&academyMember(request.resource.data.teacherUid);
   allow update:if signedIn()&&resource.data.participantUids is list&&request.auth.uid in resource.data.participantUids&&request.resource.data.participantUids==resource.data.participantUids&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage","updatedAt"]);
   allow delete:if isAdmin();
  }
  match /teacherMessages/{id}{
   allow read:if isAdmin()||(signedIn()&&resource.data.participantUids is list&&request.auth.uid in resource.data.participantUids);
   allow create:if signedIn()&&request.resource.data.senderUid==request.auth.uid&&request.resource.data.participantUids is list&&request.auth.uid in request.resource.data.participantUids&&teacherAccountActive(request.resource.data.teacherUid)&&(request.auth.uid==request.resource.data.teacherUid?academyOwner(request.resource.data.teacherUid):academyMember(request.resource.data.teacherUid))&&(!request.resource.data.keys().hasAny(["attachment"])||request.resource.data.attachment.dataUrl.size()<900000);
   allow update,delete:if isAdmin();
  }
  match /teacherGrades/{id}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid)||(signedIn()&&resource.data.studentUid==request.auth.uid&&academyMember(resource.data.teacherUid));
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid&&request.resource.data.score is number&&request.resource.data.maxScore is number&&request.resource.data.score>=0&&request.resource.data.score<=request.resource.data.maxScore&&exists(/databases/$(database)/documents/academyMemberships/$(request.resource.data.studentUid+"_"+request.auth.uid))&&get(/databases/$(database)/documents/academyMemberships/$(request.resource.data.studentUid+"_"+request.auth.uid)).data.classId==request.resource.data.classId;
   allow update,delete:if academyOwner(resource.data.teacherUid);
  }
  match /teacherNotifications/{id}{
   allow read:if isAdmin()||(signedIn()&&resource.data.recipientUid==request.auth.uid);
   allow create:if signedIn()&&request.resource.data.senderUid==request.auth.uid&&request.resource.data.recipientUid is string&&request.resource.data.conversationId is string&&exists(/databases/$(database)/documents/teacherConversations/$(request.resource.data.conversationId))&&request.auth.uid in get(/databases/$(database)/documents/teacherConversations/$(request.resource.data.conversationId)).data.participantUids&&request.resource.data.recipientUid in get(/databases/$(database)/documents/teacherConversations/$(request.resource.data.conversationId)).data.participantUids;
   allow update:if signedIn()&&resource.data.recipientUid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
   allow delete:if isAdmin();
  }
  match /teacherLiveSessions/{id}{
   allow read:if isAdmin()||academyOwner(resource.data.teacherUid)||academyMember(resource.data.teacherUid);
   allow create:if academyOwner(request.resource.data.teacherUid)&&request.resource.data.teacherUid==request.auth.uid;
   allow update,delete:if academyOwner(resource.data.teacherUid);
  }
  match /{document=**}{allow read,write:if false;}
 }
}