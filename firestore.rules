rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get("active", true)==true;}
  function owns(uid){return signedIn() && request.auth.uid==uid;}
  match /admins/{uid}{allow get:if owns(uid);allow list,create,update,delete:if false;}
  match /users/{uid}{
   allow read:if owns(uid)||isAdmin();
   allow create:if owns(uid)&&request.resource.data.uid==uid;
   allow update:if owns(uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','updatedAt']);
   allow delete:if isAdmin();
   match /bookmarks/{bookmarkId}{allow read,write:if owns(uid);}
  }
  match /publicProfiles/{uid}{
   allow read:if signedIn();
   allow create:if owns(uid)&&request.resource.data.keys().hasOnly(['displayName','xp','updatedAt'])&&request.resource.data.xp==0;
   allow update:if isAdmin()||(owns(uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt']));
   allow delete:if isAdmin();
  }
  match /subjects/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.published==true);allow create,update,delete:if isAdmin();}
  match /lessons/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.published==true);allow create,update,delete:if isAdmin();}
  match /exams/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.published==true);allow create,update,delete:if isAdmin();}
  match /examAnswerKeys/{id}{allow read,write:if isAdmin();}
  match /library/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.published==true);allow create,update,delete:if isAdmin();}
  match /notifications/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.published==true);allow create,update,delete:if isAdmin();}
  match /revisionCards/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.published==true);allow create,update,delete:if isAdmin();}
  match /dailyChallenges/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.published==true);allow create,update,delete:if isAdmin();}
  match /challengeAnswerKeys/{id}{allow read,write:if isAdmin();}
  match /simulations/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.published==true);allow create,update,delete:if isAdmin();}
  match /studyTasks/{id}{
   allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);
   allow create:if signedIn()&&request.resource.data.uid==request.auth.uid;
   allow update:if signedIn()&&resource.data.uid==request.auth.uid&&request.resource.data.uid==request.auth.uid;
   allow delete:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);
  }
  match /examResults/{id}{allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);allow create,update,delete:if isAdmin();}
  match /examAttempts/{id}{allow create:if signedIn()&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=="pending"&&!exists(/databases/$(database)/documents/examAttempts/$(request.resource.data.examId+"_"+request.auth.uid));allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);allow update,delete:if isAdmin();}
  match /challengeResponses/{id}{allow create:if signedIn()&&request.resource.data.uid==request.auth.uid&&request.resource.data.status=="pending"&&!exists(/databases/$(database)/documents/challengeResponses/$(request.resource.data.challengeId+"_"+request.auth.uid));allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);allow update,delete:if isAdmin();}
  match /communityPosts/{id}{
   allow read:if signedIn();
   allow create:if signedIn()&&request.resource.data.uid==request.auth.uid;
   allow update,delete:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);
  }
  match /messages/{id}{
   allow create:if signedIn()&&request.resource.data.uid==request.auth.uid;
   allow read:if isAdmin()||(signedIn()&&resource.data.uid==request.auth.uid);
   allow update,delete:if isAdmin();
  }
  match /{document=**}{allow read,write:if false;}
 }
}