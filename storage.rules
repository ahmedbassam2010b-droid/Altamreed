rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function teacherActive(teacherUid){
      let t = firestore.get(/databases/(default)/documents/teachers/$(teacherUid)).data;
      return signedIn()
        && request.auth.uid == teacherUid
        && t.active == true
        && t.status == "active"
        && t.subscriptionStartAt <= request.time
        && t.subscriptionEndAt > request.time;
    }
    function academyMember(teacherUid){
      let m = firestore.get(/databases/(default)/documents/academyMemberships/$(request.auth.uid + "_" + teacherUid)).data;
      let t = firestore.get(/databases/(default)/documents/teachers/$(teacherUid)).data;
      return signedIn()
        && m.status == "active"
        && t.active == true
        && t.status == "active"
        && t.subscriptionStartAt <= request.time
        && t.subscriptionEndAt > request.time;
    }
    match /teacher-content/{teacherUid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == teacherUid || academyMember(teacherUid));
      allow write: if teacherActive(teacherUid)
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/.*|video/.*)');
    }
  }
}